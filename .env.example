# ALIZAIN TIKTOK — environment variables (monorepo example)
# Copy this file to `.env` in the folder that needs it and fill in real values.
# NEVER commit a real `.env` file. No secrets are hardcoded in the code.
# This file mirrors `backend/.env.example` (verified in the built backend)
# plus the app/admin variables. Values below are placeholders only.

# --- Backend: PostgreSQL connection string (Prisma) ---
# Local dev example; production uses the Neon pooled connection string.
DATABASE_URL="postgresql://user:password@localhost:5432/alizain_tiktok?schema=public"

# --- Backend: JWT signing secrets ---
# Generate long random strings (e.g. `openssl rand -hex 32`). Keep them secret.
# Access tokens live 15 minutes; refresh tokens live 30 days.
JWT_SECRET="change-me-to-a-long-random-access-secret"
JWT_REFRESH_SECRET="change-me-to-a-long-random-refresh-secret"

# --- Backend: server ---
PORT=4000

# --- Backend: local file storage ---
# Where uploaded videos / thumbnails / sounds are stored on local disk
# when Cloudinary is NOT configured.
UPLOAD_DIR=./uploads

# --- Backend: public URLs ---
# Public URL of the app (used for share links). No localhost here in production.
PUBLIC_APP_URL="https://your-app-domain.example"
# Comma-separated origins allowed to call the API (storefront + admin website).
CORS_ORIGINS="https://your-app-domain.example"

# --- Backend: Cloudinary (OPTIONAL) ---
# Only used when ALL THREE are set; otherwise videos stay on local disk
# (UPLOAD_DIR) and are served by the backend. See documentation/api.md
# "Storage: local vs Cloudinary".
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Backend: live streaming provider (OPTIONAL) ---
# 'none' means live streaming is unavailable by design — the API returns
# available:false and the app must say so, never fake a stream.
# Supported values: none | mux | livekit
LIVE_PROVIDER="none"
LIVE_API_KEY=""
LIVE_API_SECRET=""

# --- Android app (Expo) ---
# Base URL of the backend API, baked into the app at build time.
# Local dev (Expo Go, same Wi-Fi): your computer's LAN IP, e.g. http://192.168.1.10:4000
# Production: the deployed backend URL, e.g. https://your-backend-domain.example
EXPO_PUBLIC_API_URL="http://localhost:4000"

# --- Admin website (Vite) ---
# No API-base variable is needed: the Admin Panel is served from the same
# site as the backend and calls the relative path /api (verified in
# admin-website/src/api.ts). In local dev, Vite must proxy /api + /health
# to http://localhost:4000 (see documentation/installation.md §4.3).
