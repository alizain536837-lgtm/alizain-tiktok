# ALIZAIN TIKTOK backend — copy to .env and fill in real values.
# NEVER commit a real .env file. No secrets are hardcoded in the code.

# PostgreSQL connection string (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/alizain_tiktok?schema=public"

# JWT signing secrets — generate long random strings, keep them secret
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_REFRESH_SECRET="change-me-to-a-different-long-random-secret"

# Server
PORT=4000

# Where uploaded videos/thumbnails/sounds are stored on local disk (local provider)
UPLOAD_DIR=./uploads

# Public URL of the app (used for share links). No localhost here in production.
PUBLIC_APP_URL="https://your-app-domain.example"
CORS_ORIGINS="https://your-app-domain.example"

# Cloudinary (OPTIONAL). Only used when all three are set; otherwise local disk storage.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Live streaming provider (OPTIONAL). 'none' means live is unavailable by design.
# Supported values: none | mux | livekit
LIVE_PROVIDER="none"
LIVE_API_KEY=""
LIVE_API_SECRET=""
